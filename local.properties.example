# Copy this file to local.properties and paste your real keys.
# local.properties is gitignored — your keys never enter the repository.
#
#   cp local.properties.example local.properties
#
# Where to get them:
#
#   XAI         https://console.x.ai/          -> key starts with "AQ."
#   GEMINI      https://aistudio.google.com/apikey   -> key starts with "AIzaSy"
#   ELEVENLABS  https://elevenlabs.io                -> key starts with "sk_"
#   NVIDIA      https://build.nvidia.com        -> key for NIM endpoint
#   RORK        https://rork.com                 -> Rork gateway key

XAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
NVIDIA_API_KEY=
RORK_TOOLKIT_KEY=
