# Copy this file to local.properties and paste your real keys.
# local.properties is gitignored — your keys never enter the repository.
#
#   cp local.properties.example local.properties
#
# Where to get them:
#
#   NVIDIA      https://build.nvidia.com        -> key for NIM endpoint (OpenAI-compatible)
#   ELEVENLABS  https://elevenlabs.io            -> key starts with "sk_"

NVIDIA_API_KEY=
ELEVENLABS_API_KEY=
