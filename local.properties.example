# Copy this file to local.properties and paste your real keys.
# local.properties is gitignored — your keys never enter the repository.
#
#   cp local.properties.example local.properties
#
# Where to get them:
#
#   NVIDIA  https://build.nvidia.com  -> key for the NIM endpoint (OpenAI-compatible)
#   GEMINI  https://aistudio.google.com/apikey -> key starts with "AIza"
#
# Both are optional. Environment variables take precedence over this file.
# ElevenLabs support was removed on 2026-09-07 and no longer takes a key.

NVIDIA_API_KEY=
GEMINI_API_KEY=
