# GEMINI_API_KEY: Google Gemini — neural text-to-speech and the OpenAI-compatible
# chat endpoint used as the first provider in JARVIS's fallback chain.
# Optional: without it JARVIS runs on NVIDIA NIM plus the device's own TTS.
GEMINI_API_KEY=

# NVIDIA_API_KEY: NVIDIA NIM (build.nvidia.com) — the primary reasoning brain.
# Optional at build time; the owner's key is compiled into ApiConfig.
NVIDIA_API_KEY=
