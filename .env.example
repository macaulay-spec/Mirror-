# GEMINI_API_KEY: Google Gemini — neural text-to-speech and the OpenAI-compatible
# chat endpoint. First provider in JARVIS's fallback chain, injected into BuildConfig
# at compile time (env wins over local.properties).
# Optional: without it JARVIS runs on NVIDIA NIM, whose key is compiled in.
GEMINI_API_KEY=

# NVIDIA_API_KEY: NVIDIA NIM (build.nvidia.com) — the fallback reasoning brain.
#
# NOT read by the app build any more. The key lives in ApiConfig.kt as
# HARDCODED_NVIDIA_KEY (owner decision) and the BuildConfig field was dropped, so setting
# this has no effect on the APK.
#
# It IS read by eval/jarvis_eval.py, which uses it to run the routing eval against the live
# endpoint. Setting it here (or in CI secrets) lets you eval with a different key than the
# one compiled into the app; leaving it unset makes the harness read the compiled-in key
# out of ApiConfig.kt instead, so there is still only one copy to rotate.
NVIDIA_API_KEY=
